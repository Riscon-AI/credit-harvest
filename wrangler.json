{
  "name": "riscon-credit-harvest",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "routes": [
    {
      "pattern": "creditharvest.risconlabs.com",
      "custom_domain": true
    },
    {
      "pattern": "hallucgate.risconlabs.com",
      "custom_domain": true
    }
  ]
}
